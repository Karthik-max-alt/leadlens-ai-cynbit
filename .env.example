# Local assessment mode: demo roles and synthetic demo records enabled.
LEADLENS_DEMO_MODE=true
LEADLENS_DB=data/leadlens.db
# Legacy helper used only by older core storage unit tests; the application uses LEADLENS_DB.
LEADLENS_CORE_DB=data/leadlens_core.db

# Optional. Leave blank for local keyword-based extraction and template drafting.
# When enabled and selected in the UI, inquiry text may be sent to the configured provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
